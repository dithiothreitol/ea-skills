{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ea-skills:schema:compliance",
  "title": "EA Skills compliance assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "subject",
    "date",
    "assessor",
    "verdict"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$",
      "maxLength": 80
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "assessor": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "enum": [
        "irrelevant",
        "consistent",
        "compliant",
        "conformant",
        "fully-conformant",
        "non-conformant"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "followUp": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "dispensation": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$",
          "maxLength": 80
        },
        "decision": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$",
          "maxLength": 80
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "relatedElements": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$",
        "maxLength": 80
      }
    }
  }
}
