{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ea-skills:schema:entities",
  "title": "EA Skills entity table",
  "description": "Canonical names for things the sources mention, with the aliases they are mentioned by. One term resolves to exactly one entity; the validator enforces it.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$",
      "maxLength": 80
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "kind": {
          "type": "string",
          "maxLength": 40,
          "description": "Informal hint (application, process, actor, data, technology, ...). Real ArchiMate typing happens in the modelling phase, not here."
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "uniqueItems": true
        },
        "documentation": {
          "type": "string"
        }
      }
    }
  }
}
