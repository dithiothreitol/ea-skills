{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ea-skills:schema:question",
  "title": "EA Skills clarification-question file",
  "description": "Questions a source raised and the sources could not answer. Each points at the text that raised it and, once answered, at the fact the answer produced.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$",
      "maxLength": 80
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "source",
        "status",
        "raised"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "question": {
          "type": "string",
          "minLength": 8,
          "description": "What a stakeholder is asked, phrased so they can answer it."
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "quote"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "quote": {
              "type": "string",
              "minLength": 8,
              "description": "The text that raised the question; located mechanically (QST002)."
            },
            "lines": {
              "type": "string",
              "pattern": "^[0-9]+(-[0-9]+)?$"
            }
          }
        },
        "addressedTo": {
          "type": "string",
          "minLength": 1,
          "description": "Who should answer: a role, a team, a named owner."
        },
        "status": {
          "enum": [
            "open",
            "answered",
            "withdrawn"
          ]
        },
        "raised": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "answered": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "answeredBy": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/slug"
          },
          "description": "Ids of the facts the answer produced (QST003)."
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
