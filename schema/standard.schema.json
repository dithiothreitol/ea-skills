{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ea-skills:schema:standard",
  "title": "EA Skills standard (SIB entry)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "type",
    "lifecycle"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$",
      "maxLength": 80
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "type": {
      "enum": [
        "legal",
        "industry",
        "organisation"
      ]
    },
    "lifecycle": {
      "enum": [
        "proposed",
        "trial",
        "active",
        "deprecated",
        "retired"
      ],
      "description": "Referencing a deprecated standard warns; retired blocks unless a dispensation covers it."
    },
    "description": {
      "type": "string"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "successor": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$",
      "maxLength": 80,
      "description": "The standard that replaces this one (expected once deprecated/retired)."
    },
    "lastReviewed": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
